<?xml version="1.0"?>
<!-- Server settings for a single small node (blueprint 9.1, 9.3): the laptop and the AWS host.
     The lake of the laptop has a file of its own, lake-local.xml; the host reads the lake
     from S3 and mounts no lake folder (week 3 plan 3.3). -->
<clickhouse>
    <!-- Kept below the container limit so that ClickHouse rejects a query instead of the
         kernel killing the server. The value comes from CH_MAX_SERVER_MEMORY_USAGE. -->
    <max_server_memory_usage from_env="CH_MAX_SERVER_MEMORY_USAGE"/>

    <logger>
        <level>information</level>
        <console>1</console>
    </logger>

    <!-- System log tables that grow constantly and are not used here. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
</clickhouse>
