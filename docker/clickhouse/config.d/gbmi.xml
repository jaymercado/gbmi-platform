<?xml version="1.0"?>
<!-- Server settings for a single small node (blueprint 9.1, 9.3). -->
<clickhouse>
    <!-- Kept below the container limit so that ClickHouse rejects a query instead of the
         kernel killing the server. The value comes from CH_MAX_SERVER_MEMORY_USAGE. -->
    <max_server_memory_usage from_env="CH_MAX_SERVER_MEMORY_USAGE"/>

    <!-- IcebergLocal, like every file-based engine, may only read below user_files_path
         (spike SK2, question Q4). The lake is mounted read-only at /lake, at the same path
         as in the containers that write it, because Iceberg metadata holds absolute URIs. -->
    <user_files_path>/lake/</user_files_path>

    <logger>
        <level>information</level>
        <console>1</console>
    </logger>

    <!-- System log tables that grow constantly and are not used here. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
</clickhouse>
