<?xml version="1.0"?>
<!-- The lake of the laptop and of CI: a folder (week 3 plan 3.3). The AWS host does not mount
     the file. -->
<clickhouse>
    <!-- IcebergLocal, like every file-based engine, may only read below user_files_path
         (spike SK2, question Q4). The lake is mounted read-only at /lake, at the same path
         as in the containers that write it, because Iceberg metadata holds absolute URIs. -->
    <user_files_path>/lake/</user_files_path>
</clickhouse>
