# Values that stay out of Git (week 1 plan 3.3). Copy to infra/terraform/local.env, which is
# git-ignored; `make plan` reads it. The repository ids come from:
#   gh api repos/OWNER/gbmi-platform --jq '{owner_id: .owner.id, repository_id: .id}'
TF_VAR_alert_email=you@example.com
TF_VAR_github_repository=OWNER/gbmi-platform
TF_VAR_github_owner_id=0
TF_VAR_github_repository_id=0
