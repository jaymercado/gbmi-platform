{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      [
        "InstanceId"
      ],
      [
        "InstanceId",
        "path"
      ]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ]
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/gbmi-user-data.log",
            "log_group_name": "__HOST_LOG_GROUP__",
            "log_stream_name": "{instance_id}/user-data"
          },
          {
            "file_path": "/var/log/gbmi-deploy.log",
            "log_group_name": "__HOST_LOG_GROUP__",
            "log_stream_name": "{instance_id}/deploy"
          }
        ]
      }
    }
  }
}
