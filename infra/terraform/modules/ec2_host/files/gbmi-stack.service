# Starts the deployed release of the GBMI platform at boot (week 3 plan 3.3). The schedule of
# the host stops the instance each night and starts it each morning; the unit brings the
# stack up again. Without a deployed release the unit does nothing.
[Unit]
Description=GBMI platform: the Compose stack of the deployed release
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/gbmi/DEPLOYED

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gbmi-stack-up
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
