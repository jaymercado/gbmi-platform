# Template for the git-ignored .env file that Docker Compose reads.
#
# `make setup` creates .env from this file and replaces every placeholder with a freshly
# generated value. Values already present in .env are kept, so the command is safe to repeat.
# Never commit .env.

# --- Secrets (generated) ----------------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
AIRFLOW_DB_PASSWORD=__GENERATE__
GBMI_DB_PASSWORD=__GENERATE__
# The read-only role gbmi_ro: ClickHouse reads the schema ops with the role (named collection pg_ops).
GBMI_RO_DB_PASSWORD=__GENERATE__
METABASE_DB_PASSWORD=__GENERATE__

CLICKHOUSE_ADMIN_PASSWORD=__GENERATE__
CH_DBT_PASSWORD=__GENERATE__
CH_BI_PASSWORD=__GENERATE__
CH_GBMI_PASSWORD=__GENERATE__

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__GENERATE__
AIRFLOW_FERNET_KEY=__GENERATE_FERNET__
AIRFLOW_JWT_SECRET=__GENERATE__

METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=__GENERATE__
METABASE_ENCRYPTION_KEY=__GENERATE__

# --- SEC EDGAR (blueprint 4.3) ----------------------------------------------------------------
# The declared identity of every live request to the SEC: a name and a contact address, in the
# form "Sample Company Name contact@example.org". The value stays empty here and in CI: without
# a value no live client starts, and make demo reads the recorded files with a placeholder.
# Never commit the value: make redact-check searches the repository for the address.
GBMI_SEC_USER_AGENT=

# --- Environment ------------------------------------------------------------------------------
# gbmi settings (blueprint 9.5). The lake backend, its URI and the catalog are fixed in
# compose/compose.yaml for the local stack.
GBMI_ENV=local
DBT_TARGET=local

# --- Memory limits (blueprint 9.1) -------------------------------------------------------------
# Ceilings, not reservations: the core profile adds up to 7.5 GB and Metabase adds 1.5 GB on
# demand, while the stack actually uses about 2 GB idle and 4 GB during the demo. The split
# follows the measurements in docs/reports/p0-memory.md: the API server peaked at 778 MiB
# under the blueprint's 0.8 GB, and Metabase needs 1.1 GB with a 640 MiB heap. Docker Desktop
# should be given 9 GB. Set a value to 0 to remove that limit.
MEM_AIRFLOW_APISERVER=1000m
MEM_AIRFLOW_SCHEDULER=2600m
MEM_AIRFLOW_DAG_PROCESSOR=500m
MEM_AIRFLOW_TRIGGERER=400m
MEM_POSTGRES=512m
MEM_CLICKHOUSE=2500m
MEM_METABASE=1536m
# ClickHouse's own ceiling, in bytes, kept below its container limit.
CH_MAX_SERVER_MEMORY_USAGE=2147483648
# Metabase's heap. The JVM needs about 470 MiB beyond it.
METABASE_JAVA_OPTS="-Xms256m -Xmx640m"
