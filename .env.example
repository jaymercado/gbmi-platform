# Template for the git-ignored .env file. `make setup` copies it; never commit .env.
#
# Settings of the gbmi package (blueprint 9.5). These are the values for the local backend:
# a filesystem lake mounted at /lake in every container, with a SQLite catalog.
GBMI_ENV=local
GBMI_LAKE_BACKEND=local
GBMI_LAKE_URI=file:///lake
GBMI_CATALOG_URI=sqlite:////lake/catalog/catalog.db
GBMI_WATCHLIST_SIZE=50
