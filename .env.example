# Template for the git-ignored .env file that Docker Compose reads.
#
# `make setup` creates .env from this file and replaces every placeholder with a freshly
# generated value. Values already present in .env are kept, so the command is safe to repeat.
# Never commit .env.

# --- Secrets (generated) ----------------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
AIRFLOW_DB_PASSWORD=__GENERATE__
GBMI_DB_PASSWORD=__GENERATE__
METABASE_DB_PASSWORD=__GENERATE__

CLICKHOUSE_ADMIN_PASSWORD=__GENERATE__
CH_DBT_PASSWORD=__GENERATE__
CH_BI_PASSWORD=__GENERATE__
CH_GBMI_PASSWORD=__GENERATE__

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__GENERATE__
AIRFLOW_FERNET_KEY=__GENERATE_FERNET__
AIRFLOW_JWT_SECRET=__GENERATE__

METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=__GENERATE__
METABASE_ENCRYPTION_KEY=__GENERATE__

# --- Environment ------------------------------------------------------------------------------
# gbmi settings (blueprint 9.5). The lake backend, its URI and the catalog are fixed in
# compose/compose.yaml for the local stack.
GBMI_ENV=local
DBT_TARGET=local

# --- Memory limits (blueprint 9.1) -------------------------------------------------------------
# The core profile adds up to 7.5 GB; Metabase adds 1.2 GB on demand. Docker Desktop needs
# about 9 GB. Set a value to 0 to remove that limit.
MEM_AIRFLOW_APISERVER=800m
MEM_AIRFLOW_SCHEDULER=2800m
MEM_AIRFLOW_DAG_PROCESSOR=500m
MEM_AIRFLOW_TRIGGERER=400m
MEM_POSTGRES=512m
MEM_CLICKHOUSE=2500m
MEM_METABASE=1200m
# ClickHouse's own ceiling, in bytes, kept below its container limit.
CH_MAX_SERVER_MEMORY_USAGE=2147483648
METABASE_JAVA_OPTS="-Xms256m -Xmx800m"
